@page
@model AIStudyPlanner.Pages.StudyGoals.AddModel

@{
    ViewData["Title"] = "Add Study Goal";
}

<div class="subjects-page">

    <div class="subjects-header">

        <div>
            <p class="dashboard-label">AI STUDY PLANNER</p>

            <h1>Add a Study Goal 🎯</h1>

            <p>
                Define a goal and give yourself a clear target.
            </p>
        </div>

    </div>

    <div class="dashboard-card">

        <form method="post">

            <div class="form-group">

                <label asp-for="Goal.Title">
                    Goal Title
                </label>

                <input asp-for="Goal.Title"
                       class="form-control"
                       placeholder="e.g. Get an A in Mathematics" />

            </div>

            <div class="form-group">

                <label asp-for="Goal.Description">
                    Description
                </label>

                <textarea asp-for="Goal.Description"
                          class="form-control"
                          rows="4"
                          placeholder="e.g. Prepare for the final mathematics exam"></textarea>

            </div>

            <div class="form-group">

                <label asp-for="Goal.TargetDate">
                    Target Date
                </label>

                <input asp-for="Goal.TargetDate"
                       type="date"
                       class="form-control" />

            </div>

            <div class="form-group">

                <label asp-for="Goal.TargetGrade">
                    Target Grade
                </label>

                <input asp-for="Goal.TargetGrade"
                       class="form-control"
                       placeholder="e.g. A" />

            </div>

            <div style="
                margin-top: 25px;
                text-align: center;
            ">

                <button type="submit"
                        class="primary-dashboard-button">

                    Save Goal

                </button>

                <a asp-page="/Dashboard"
                   style="margin-left: 12px;">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>