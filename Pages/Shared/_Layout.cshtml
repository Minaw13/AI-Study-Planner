<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - AI Study Planner</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AIStudyPlanner.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&display=swap" rel="stylesheet">
</head>

<body>

    <!-- Navigation -->
    <header>
        <nav class="main-navbar">

            <div class="navbar-container">

                <div class="brand">
                    <span>💖 AI Study Planner 💖</span>
                </div>


                <div class="nav-links">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (ViewContext.RouteData.Values["page"]?.ToString() != "/Index")
                        {
                            <a asp-page="/Index"
                               class="header-button login-button">
                                Home
                            </a>
                        }

                        <a asp-page="/Dashboard"
                           class="header-button login-button">
                            Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-page="/Account/Login"
                           class="header-button login-button">
                            Login
                        </a>

                        <a asp-page="/Account/Register"
                           class="header-button signup-button">
                            Get Started
                        </a>
                    }

                </div>

            </div>

        </nav>
    </header>

    <!-- Page Content -->

    <main role="main">
        @RenderBody()
    </main>


    <footer class="site-footer">

        <div class="footer-contact">

            <div class="contact-title"
                 style="
                    margin-bottom: 35px;
                    transform: translateX(-130px);
                 ">
                <h3>Contact Us:</h3>
            </div>

            <form method="post"
                  asp-page="/Subscribe"
                  class="footer-subscribe-form"
                  novalidate>

                <input type="email"
                       name="email"
                       class="footer-email"
                       placeholder="Enter your email" />

                <button type="submit" class="footer-send-button">
                    Send
                </button>

            </form>

        </div>

        <script>

            setTimeout(function () {

                const message = document.getElementById("subscribeMessage");

                if (message) {

                    message.style.transition = "opacity 0.5s ease";

                    message.style.opacity = "0";

                    setTimeout(function () {

                        message.remove();

                    }, 500);

                }

            }, 5000);

        </script>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>

        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

        <script src="~/js/site.js" asp-append-version="true"></script>

        @await RenderSectionAsync("Scripts", required: false)

    </footer>

</body>
</html>